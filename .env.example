# Runtime
APP_ENV=development
PORT=8000
WEB_PORT=3000
DATA_DIR=./data
TRADEMIND_DB_PATH=./data/trademind.db
API_ORIGIN=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REDIS_URL=redis://localhost:6379/0

# Authentication. Replace the secret before any shared/production deployment.
AUTH_REQUIRED=true
ALLOW_PUBLIC_REGISTRATION=false
TRADEMIND_JWT_SECRET=trademind-local-development-secret-change-before-production
JWT_ISSUER=trademind
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# Development placeholder only. Production requires an independent, unique 32+ byte value.
BOOTSTRAP_ADMIN_TOKEN=trademind-local-bootstrap-token-change-before-production

# Optional OpenAI-compatible synthesis. Research/risk logic works offline.
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=45
LLM_MAX_INPUT_CHARS=60000
LLM_MAX_OUTPUT_TOKENS=1200
# Explicitly configure current input/output USD-per-million rates if cost estimates are needed.
LLM_PRICING_JSON=

# Safety and storage
PAPER_INITIAL_CASH=100000
MAX_UPLOAD_MB=20
MAX_MARKET_SNAPSHOT_AGE_SECONDS=259200
MARKET_MAX_FUTURE_SKEW_SECONDS=300
MAX_PRICE_DEVIATION_PCT=5
MAX_AI_TOKENS_PER_USER_PER_DAY=200000
MAX_AI_CALLS_PER_USER_PER_DAY=100
MAX_RAG_DOCUMENTS_PER_USER=50
MAX_RAG_CHARACTERS_PER_USER=10000000

# OCR is optional; install backend/requirements-ocr.txt to enable scanned PDFs.
